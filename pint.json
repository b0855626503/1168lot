{
  "preset": "laravel",
  "rules": {
    "no_extra_blank_lines": true,
    "ordered_imports": false,
    "class_attributes_separation": {
      "elements": {
        "method": "one"
      }
    },
    "single_blank_line_before_namespace": true
  },
  "exclude": [
    "vendor",
    "node_modules",
    "storage"
  ]
}
