{
    "name": "gametech/website",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-mongodb": "*",
        "ext-redis": "*",
        "alexmg86/laravel-sub-query": "^1.9",
        "awobaz/compoships": "^2.0",
        "bacon/bacon-qr-code": "^2.0",
        "bagisto/bagisto-package-generator": "^2.0",
        "doctrine/dbal": "^2.0",
        "endroid/qr-code": "^5.0",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "infyomlabs/adminlte-templates": "^6.0",
        "infyomlabs/laravel-generator": "^6.0",
        "jaybizzle/laravel-crawler-detect": "^1.2",
        "jenssegers/agent": "^2.6",
        "klevze/online-users": "^0.1.2",
        "konekt/concord": "^1.17",
        "laravel/framework": "^10.49",
        "laravel/horizon": "^5.45",
        "laravel/octane": "^2.17",
        "laravel/reverb": "^1.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.6",
        "league/fractal": "^0.19.2",
        "maatwebsite/excel": "^3.1",
        "minishlink/web-push": "^9.0",
        "mongodb/laravel-mongodb": "^4.1",
        "php-curl-class/php-curl-class": "^9.1",
        "pragmarx/google2fa-laravel": "^3.0",
        "predis/predis": "^1.1",
        "prettus/l5-repository": "^2.7",
        "pusher/pusher-php-server": "^7.2",
        "rap2hpoutre/fast-excel": "^5.7",
        "silviolleite/laravelpwa": "^2.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spiritix/lada-cache": "^5.1",
        "voku/simple_html_dom": "^4.7",
        "yajra/laravel-datatables-buttons": "^10.0",
        "yajra/laravel-datatables-html": "^10.12",
        "yajra/laravel-datatables-oracle": "^10.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/boost": "^1.8",
        "laravel/pint": "^1.22",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^7.12",
        "phpunit/phpunit": "^10",
        "spatie/laravel-ignition": "^2.8",
        "thecodingmachine/phpstan-safe-rule": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false,
        "platform": {
            "ext-pcntl": "8.1",
            "ext-posix": "8.1"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/dusk",
                "mockery/mockery"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Gametech\\Admin\\": "packages/Gametech/Admin/src",
            "Gametech\\Auto\\": "packages/Gametech/Auto/src",
            "Gametech\\Core\\": "packages/Gametech/Core/src",
            "Gametech\\Member\\": "packages/Gametech/Member/src",
            "Gametech\\API\\": "packages/Gametech/API/src",
            "Gametech\\Game\\": "packages/Gametech/Game/src",
            "Gametech\\Promotion\\": "packages/Gametech/Promotion/src",
            "Gametech\\Ui\\": "packages/Gametech/Ui/src",
            "Gametech\\Payment\\": "packages/Gametech/Payment/src",
            "Gametech\\Wallet\\": "packages/Gametech/Wallet/src",
            "Gametech\\LogAdmin\\": "packages/Gametech/LogAdmin/src",
            "Gametech\\LogUser\\": "packages/Gametech/LogUser/src",
            "Gametech\\Marketing\\": "packages/Gametech/Marketing/src",
            "Gametech\\CenterOA\\": "packages/Gametech/CenterOA/src",
            "Gametech\\LineOA\\": "packages/Gametech/LineOA/src",
            "Gametech\\Reward\\": "packages/Gametech/Reward/src",
            "Gametech\\Lotto\\": "packages/Gametech/Lotto/src",
            "Gametech\\FrontendApi\\": "packages/Gametech/FrontendApi/src"
        },
        "files": [
            "packages/Gametech/Core/src/Http/helpers.php",
            "packages/Gametech/Admin/src/Http/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan horizon\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=server,horizon,queue,vite --kill-others"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#fca5a5\" \"php artisan serve\" \"php artisan horizon\" \"php artisan reverb:start --host=0.0.0.0 --port=${REVERB_SERVER_PORT:-8080}\" \"php artisan queue:listen --tries=1\" --names=server,horizon,reverb,queue --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
